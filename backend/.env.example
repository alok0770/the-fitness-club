# =============================================================================
# THE FITNESS CLUB (Joshiyara Road HQ • Uttarkashi)
# Spring Boot Backend Environment Configuration
# =============================================================================

# Server Port (Render sets this dynamically via PORT)
PORT=8080

# PostgreSQL Database (Render External / Internal Database URL)
# Example: postgresql://tfc_user:secret@dpg-xxxx.render.com/tfc_db
DATABASE_URL=
DB_USERNAME=
DB_PASSWORD=

# Single-Owner Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TheFitnessClub@2026

# JWT Secret Key (Must be at least 256 bits / 32 characters)
JWT_SECRET=the-fitness-club-joshiyara-road-hq-uttarkashi-super-secret-jwt-key-minimum-256-bits-length

# Cloudinary Image Storage Credentials (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://the-fitness-club.vercel.app
